# ============================================================
# Market Risk & Wave Analyzer — Variables de entorno
# ============================================================
# Copia este archivo y renómbralo como: .env
# Luego pega tus API keys donde corresponde.
# El archivo .env NUNCA se sube a internet — queda solo en tu PC.

# --- Alpha Vantage ---
# Registro gratuito en: https://www.alphavantage.co/support/#api-key
# Plan gratuito: 25 llamadas por día
ALPHA_VANTAGE_KEY=TU_API_KEY_AQUI

# --- Finnhub ---
# Registro gratuito en: https://finnhub.io/register
# Plan gratuito: 60 llamadas por minuto
FINNHUB_KEY=TU_API_KEY_AQUI

# --- Proveedor por defecto ---
# Opciones: yahoo (gratis, sin key) | alphavantage | finnhub
# Si dejas "yahoo", la herramienta funciona sin ninguna key.
DEFAULT_PROVIDER=yahoo
